  {
    "category": "Social, Recompensas & Matrimonios",
    "commands": [
      {
        "command": "/canjear <código>",
        "permission": "Todos los jugadores",
        "desc": "Canjea un código de premio promocional o recompensa de evento en el servidor.",
        "example": "/canjear MIPRIMERKIT"
      },
      {
        "command": "/marry <jugador>",
