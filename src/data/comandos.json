  },
  {
    "category": "Comandos de Administración & Tumba (Graves)",
    "commands": [
      {
        "command": "/korograve list [jugador]",
        "permission": "Administradores (group.admin)",
        "desc": "Lista todas las tumbas activas o cuerpos de maniquí en el mundo.",
        "example": "/korograve list Insent"
      },
      {
        "command": "/korograve history [jugador]",
        "permission": "Administradores (group.admin)",
        "desc": "Muestra el historial permanente de respaldos de tumbas recuperables.",
